{
  "$schema": "https://aka.ms/dsc/schemas/v3/bundled/resource/manifest.json",
  "type": "Example.Hosts/Entry",
  "description": "Ensure an '<ip> <hostname>' line is present in or absent from /etc/hosts",
  "version": "0.1.0",
  "get": {
    "executable": "hosts-entry.dsc.resource.sh",
    "args": ["get"],
    "input": "env"
  },
  "set": {
    "executable": "hosts-entry.dsc.resource.sh",
    "args": ["set"],
    "input": "env",
    "handlesExist": true,
    "implementsPretest": true,
    "return": "state"
  },
  "exitCodes": {
    "0": "Success",
    "10": "Invalid input",
    "11": "Hosts file not writable"
  },
  "schema": {
    "embedded": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Hosts entry",
      "type": "object",
      "required": ["ip", "hostname"],
      "additionalProperties": false,
      "properties": {
        "ip": { "type": "string", "pattern": "^[0-9A-Fa-f:.]+$" },
        "hostname": { "type": "string", "pattern": "^[A-Za-z0-9.-]+$" },
        "_exist": { "type": "boolean", "default": true }
      }
    }
  }
}
