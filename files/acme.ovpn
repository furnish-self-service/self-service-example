# EXAMPLE: Acme VPN, replace vpn.acme.example and the CA certificate below.
client
dev tun
proto udp
remote vpn.acme.example 1194
resolv-retry infinite
nobind
persist-key
persist-tun
remote-cert-tls server
auth-user-pass
cipher AES-256-GCM
verb 3
<ca>
-----BEGIN CERTIFICATE-----
EXAMPLE-ONLY-REPLACE-WITH-YOUR-ORGANIZATIONS-CA-CERTIFICATE
-----END CERTIFICATE-----
</ca>
